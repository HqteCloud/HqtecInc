---
import Navigation from '@components/Navigation/index.astro'
import Footer from '@components/Footer/index.astro'
import '../styles/global.styles.scss';
const { SEO } = Astro.props;
---
<html lang="en">
	<head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="image_src" href="" />

        <!-- Register Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

        <!-- Primary Meta Tags -->
        <title>{ SEO.title }</title>
        <meta name="title" content={ SEO.title }>
        <meta name="description" content={ SEO.description }>

        <!-- Open Graph / Facebook -->
        <meta property="og:site_name" content="Hqtec Inc"/>
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://hqtecinc.com/">
        <meta property="og:title" content={ SEO.title }>
        <meta property="og:description" content={ SEO.description }>
        <meta property="og:image" content="https://thumbs2.imgbox.com/4b/cf/Pa8NRTXM_t.png">
        <meta property="og:image:width" content="500"/>
        <meta property="og:image:height" content="276"/>
        
        <meta itemprop="name" content="Hqtech Inc"/>
        <meta itemprop="url" content="https://hqtecinc.com"/>
        <meta itemprop="description" content={SEO.description}/>
        <meta itemprop="thumbnailUrl" content="https://thumbs2.imgbox.com/4b/cf/Pa8NRTXM_t.png"/>
        <meta itemprop="image" content="https://thumbs2.imgbox.com/4b/cf/Pa8NRTXM_t.png"/>

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content="https://hqtecinc.com/">
        <meta property="twitter:title" content={ SEO.title }>
        <meta property="twitter:description" content={ SEO.description }>
        <meta property="twitter:image" content="https://thumbs2.imgbox.com/4b/cf/Pa8NRTXM_t.png">

        <link rel="preload" href="/img/01.webp" as="image">
        <link rel="preload" href="/img/02.webp" as="image">
        <link rel="preload" href="/img/03.webp" as="image">

    </head>
	<body>
        <Navigation />
		<slot />
        <Footer />
	</body>
</html>