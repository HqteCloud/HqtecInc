---
import DefaultWrapper from '@layouts/default.astro'
const description = 'We work with corporations to build and maintain excellent technical infrastructure, with our seasoned field technicians specializing in cabling, computer hardware & software installations, CCTV alarm system setup, and more.'
---

<DefaultWrapper SEO={{
	title: 'About Us - computer hardware & software installations, CCTV alarm system setup, and more.',
	description: description.substring(0, 150) + '...',
}}>
	<img src="/img/01.webp" alt="" class="hero-img">
	<section class="section-1 align-center">
		<div class="container max-width">
			<div class="box">
				<div>
					<h2>Making it click!</h2>
					<p>Hqtech Inc provides expert technology consulting, installation, maintenance and support all over the United States. We work with corporations to build and maintain excellent technical infrastructure.</p>
				</div>
			</div>
			<div class="box">
				<div>
					<h2>Mission Statement</h2>
					<p>Here at JTS, our mission is to embrace unique challenges and provide practical technical solutions that inspire a habit of excellence within our clients.</p>
				</div>
			</div>
			<div class="box">
				<div>
					<h2>Our clients</h2>
					<p>JTS serves a wide-range of clients with a multi-location presence regionally or nationally in the retail, restaurant, hospitality, government and financial industries.</p>
				</div>
			</div>
		</div>
	</section>
	<img src="/img/03.webp" alt="" class="filler">
	<section class="section-2 align-center">
		<div class="container max-width">
			<div>
				<p>Who are we?</p>
				<h1 class="content-heading">ABOUT US</h1>
			</div>
			<div>
				<p>Hqtech Inc provides expert technology consulting, installation, maintenance and support all over the United States. We work with corporations to build and maintain excellent technical infrastructure. Our seasoned field technicians specialize in cabling, point-of-sale, computer hardware & software installations, CCTV alarm system setup, and more. Our in-house team handles project management and digital marketing for businesses. Together, Hqtec Inc works to ensure that our clients form a strategic advantage over their competition.</p>
			</div>
		</div>
	</section>
	<section class="section-3 align-center">
		<div class="container max-width">
			<div>
				<h3>Our field technicians</h3>
				<p>Hqtec Inc field technicians consist of W2 employees and 1099 business partners. In both cases, these professional technicians are duly vetted for extensive experience and skills that meet our  set standard of excellence. All our technicians have extensive skill sets ranging from low voltage cabling, fiber optic certification, software  to specific hardware installation experience, and more.</p>
			</div>
			<div>
				<h3>Quality Assurance</h3>
				<p>The management and staff of Hqtech Inc share the responsibility for our product and service quality. Our Quality Assurance System is designed to ensure that all processes and procedures, from our office to field technicians and our client's site, meet established industry requirements. These procedures must be adequately documented from a procedural and data traceability perspective as executed by the staff and technicians. This assures our clients receive cost effective service and sustained  use of their devices.</p>
			</div>
		</div>
	</section>
</DefaultWrapper>

<style lang="scss">
@import "../styles/global.styles.scss";
@import "../styles/breakpoints.scss";

img {
	object-fit: cover;
	width: 100%;

	&.hero-img { height: 332px; }
	&.filler { height: 184px; }
}
.section-1 {
	border-bottom: 1px solid var(--border);
	.container {
		margin: $gap;display: grid;
		grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
		// grid-row-gap: 2em;
		margin: 0 $gap;
		.box {
			border-bottom: 1px solid var(--border);
			div {
				margin: $gap;
				@include tablet { margin: $gap; }
			}
			@include tablet {border: 0;}
			&:nth-child(even) {
				@include tablet {
					border-right: 1px solid var(--border);
					border-left: 1px solid var(--border);
				}
			}
		}
		
		@include tablet { margin: 0 $gap; }
	}
}
.section-2 {
	.container {
		margin: $gap;
		display: grid;
		grid-column-gap: 2em;

		h1.content-heading { font-size: 6.375em; font-weight: 700;}
		@include tablet {
			grid-template-columns: 1.5fr 2fr;
		}
	}
}
.section-3 {
	border-top: 1px solid var(--border);
	.container {
		display: grid;
		div{
			padding: $gap; h3 { margin-bottom: 1em; }
			&:first-child { border-right: 1px solid var(--border); }
		}
		@include tablet {
			grid-template-columns: 1fr 1fr;
		}
	}
}
</style>