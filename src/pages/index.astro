---
import DefaultWrapper from '@layouts/default.astro'
import Services from '@components/Services/index.astro'
---

<DefaultWrapper SEO={{
	title: 'Hqtec Inc -  Expert technology consulting, maintenance, & support.',
	description: 'We provide expert technology consulting, installation, maintenance, & support all over the United States ensuring a strategic advantage for our clients.'
}}>
	<!-- <h1 class="hero">HQTECH INC</h1> -->
	<div class="align-center image">
		<img src="/img/04.webp" alt="">
	</div>
	<section class="section-1 align-center">
		<div class="container max-width">
			<div class="box">
				<div>
					<h2>Making it click!</h2>
					<p>Hqtech Inc provides expert technology consulting, installation, maintenance and support all over the United States. We work with corporations to build and maintain excellent technical infrastructure.</p>
				</div>
			</div>
			<div class="box">
				<div>
					<h2>Our Mission</h2>
					<p>Here at HqtecInc, our mission is to embrace unique challenges and provide practical technical solutions that inspire a habit of excellence within our clients.</p>
				</div>
			</div>
		</div>
	</section>
	<section class="section-2 align-center">
		<figure class="max-width">
			<img src="/img/22.jpg" alt="" title="">
			<figcaption></figcaption>
		</figure>
	</section>
	<section class="section-3 align-center">
		<Services />
	</section>
	<section class="section-4 align-center">
		<div class="max-width">
			<div>
				<h2 class="about-us">ABOUT US</h2>
				<p>HqtecInc provides expert technology consulting, installation, maintenance and support all over the United States. We work with corporations to build and maintain excellent technical infrastructure. Our seasoned field technicians specialize in cabling, point-of-sale, computer hardware & software installations, CCTV alarm system setup, and more.</p>
				<a href="/about-us">More about us</a>
			</div>
			<img src="/img/02.webp" alt="">
		</div>
	</section>
</DefaultWrapper>

<style lang="scss">
@import "../styles/global.styles.scss";
@import "../styles/breakpoints.scss";

.about-us {
	font-size: 3.375em;
	font-weight: 700;
	font-family: 'Josefin Sans', sans-serif;
}
.image {
	img {
		width: 100%;
		height: 360px;
		object-fit: cover;
	}
}
.section-1 {
	border-top: 1px solid var(--border);
	.container {
		margin: $gap;
		.box {
			div {
				
				max-width: 385px;
				@include tablet { margin: $gap; }
			}
			&:first-child {
				div { margin-left: 0;margin-bottom: $gap; }
				@include tablet {
					border-right: 1px solid var(--border);
				}
			}
		}

		@include tablet {
			display: flex;
			align-items: flex-start;
			margin: 0 $gap;
		}
	}
}
.section-2 {
	border-top: 1px solid var(--border);
	.max-width {
		margin: 1em $gap;
		img {
			width: 100%;
			height: 300px;

			object-fit: cover;
		}
		// figcaption { margin-top: 1em; }
	}
}
.section-3 {
	border-top: 1px solid var(--border);
}
.section-4 {
	border-top: 1px solid var(--border);
	.max-width {
		div {
			margin: $gap;
			display: grid;
			grid-row-gap: 1em;
			a {
				padding:0 2em;
				border: 1px solid var(--border);
				min-height: 60px; 
				display: flex; align-items: center;

				&:focus {
					outline: .2em solid var(--base);
					border: 0;
				}
			}
		}
		img {
			height: 303px;
			// height: 100%;
			width: 100%;
			object-fit: cover;

			@include tablet { height: 403px; }
		}

		@include tablet {
			display: grid; margin: $gap;
			grid-template-columns: repeat(2, 1fr);
			grid-column-gap: 2em ;
		}
	}
}
</style>