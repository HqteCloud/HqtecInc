---
import DefaultWrapper from '@layouts/default.astro';
import Services from '@components/Services/index.astro';
import ReachoutForm from '@components/Form/index.vue';

export const getStaticPaths = async () => {
    const pages = await Astro.glob('../assets/*.json');
    return pages.map(({ path, title, content, form }) => {
        return {
            params: { slug: path },
            props: { title, content, form }
        };
    });
}

const { title, content, form } = Astro.props
---

<DefaultWrapper SEO={{
    title: title.substring(0, 150) + '...',
    description: content.description.substring(0, 150) + '...'
}}>
	<section class="section-1 align-center">
        <div class="container max-width">
            <header>
                <div>
                    <h1 class="content-heading">{ title }</h1>
                    <p>{content.description.substring(0, 200) + '...'}</p>
                    <div class="button-group">
                        <a href="/contact-us" class="button">Reach out to us</a>
                        <a href="#getstarted">Get Started</a>
                    </div>
                </div>
            </header>
            <div>
                <img src="/img/02.webp" alt="">
            </div>
        </div>
	</section>
    <section class="section-2 align-center">
        <div class="container max-width">
            <div>
                <p>{content.description}</p>
            </div>
            <div>
                <ol>
                    {
                        content.services.map((item) => (
                            <li>{item}</li>
                        ))
                    }
                </ol>
            </div>
        </div>
    </section>
    <section class="section-3 align-center" id="getstarted">
        <div class="container max-width">
            <header>
                <h2 class="content-heading">Apply for {title}</h2>
                <p>Thank you for considering a relationship with Jeremi Technology Solutions for general services. Please fill out the spaces below and provide a detailed description of what you would like to accomplish. Additionally, you can use the message box for any questions or concerns you may have about projects, services, and pricing. Please allow up to 48 hours for a response.</p>
                <ReachoutForm client:only="vue" form={form} />
            </header>
        </div>
    </section>
    <section class="section-4 align-center"><Services /></section>
</DefaultWrapper>

<style lang="scss">
@import "../styles/global.styles.scss";
@import "../styles/breakpoints.scss";

.section-1 {
    background: rgb(44, 44, 44);
    .container {
        margin: $gap;  
        div img {
            width: 100%;
            min-height: 303px;
            object-fit: cover;
        }
        @include tablet {
            display: grid; margin: 0 $gap;
            grid-template-columns: repeat(2, 1fr);
        }
    }
    header {
        max-width: 500px; margin: 1em 0;
        display: flex; align-items: center;
        justify-content: center;
    }
    h1,p,a { color: #fff; }
    @include tablet { border-top: 1px solid var(--border); }
}
.section-2 {
    border-top: 1px solid var(--border);
    .container {
        margin: $gap;
        @include tablet {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-column-gap: 4em;
        }
        line-height: 1.8;
        ol {
            margin-left: 1em;
            margin-top: $gap;
            @include tablet { margin: 0}
        }
    }
}
.section-3 {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    .container { margin: $gap; }
    header { max-width: 85%; }
}
.button-group { margin: $gap 0; }
.button {
    padding: 1em $gap;
    border: 1px solid var(--border);
    border-radius: $gap-large;
    margin-right: 1em;

    &:hover { cursor: pointer;}
    &:focus {outline: .2em solid var(--brand);}
}
</style>